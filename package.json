{
  "name": "terra-agent",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev/dev.mjs",
    "dev:restart": "node scripts/dev/dev-restart.mjs",
    "dev:client": "vite --host 127.0.0.1 --port 5173",
    "ci:fast": "npm run check && npm test && npm run build",
    "scenario": "node scripts/dev/scenario.mjs",
    "e2e": "node scripts/dev/e2e.mjs",
    "sim:bench": "node scripts/dev/sim-bench.mjs",
    "build": "npm run typecheck && node scripts/check-structure.mjs && vite build",
    "typecheck": "tsc --noEmit && npm run typecheck --workspaces --if-present --silent",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run check:structure && npm run gen:check",
    "check:structure": "node scripts/check-structure.mjs",
    "gen": "node scripts/gen/run.mjs",
    "gen:check": "node scripts/gen/run.mjs --check",
    "wave": "node scripts/wave/wave.mjs",
    "validate:models": "node .agents/skills/model-geometry-validator/scripts/validate-model.mjs",
    "test:models": "node .agents/skills/model-geometry-validator/scripts/self-test.mjs",
    "db:up": "docker compose -f infra/docker-compose.yml up -d --wait",
    "db:down": "docker compose -f infra/docker-compose.yml down",
    "db:gen": "npm run db:gen -w @terra/db --silent --",
    "db:migrate": "npm run db:migrate -w @terra/db --silent",
    "db:reset": "npm run db:reset -w @terra/db --silent"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.16.20",
    "@types/node": "^26.6.6",
    "@types/three": "^0.174.0",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "unplugin-swc": "^2.0.0",
    "vite": "^6.4.5",
    "vitest": "^5.0.5"
  },
  "workspaces": [
    "shared/contracts",
    "shared/config",
    "shared/db",
    "shared/sim",
    "backend/app",
    "frontend/render",
    "frontend/design",
    "frontend/game",
    "frontend/landing",
    "frontend/playground"
  ]
}
