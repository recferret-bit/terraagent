enum SnapshotKind {
  PERIODIC
  SHUTDOWN
  SEAL
  END
  HOURLY

  @@schema("world")
}

model PlanetSnapshot {
  id         BigInt       @id @default(autoincrement())
  planetId   String       @map("planet_id")
  tick       BigInt
  simVersion Int          @map("sim_version")
  /// "msgpack+gz"
  codec      String       @db.VarChar(16)
  /// compressed size
  sizeBytes  Int          @map("size_bytes")
  /// uncompressed size
  rawBytes   Int          @map("raw_bytes")
  /// of compressed bytes; corruption means fall back to the previous snapshot
  crc32      Int
  kind       SnapshotKind
  /// wall clock at capture; restart fast-run uses now - savedAt (CONTINUITY CT-51)
  savedAt    DateTime     @map("saved_at") @db.Timestamptz(3)
  data       Bytes
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([planetId, tick])
  @@index([planetId, tick(sort: Desc)])
  @@schema("world")
  @@map("planet_snapshot")
}

/// Server-only double-entry journal of a planet's colony resources (D-34): one row per sim posting. Clients only get
/// balances (`col.stock`); this table is the full history. Identity = (planet, tick, index of the posting in that tick).
model LedgerEntry {
  planetId  String   @map("planet_id")
  tick      BigInt
  /// index of the posting within its tick (deterministic: the sim's posting order)
  idx       Int
  /// closed reason code from the sim's catalog (`construction.spend`, …)
  reason    String
  /// who caused it (`player:p_123`, `system:landing`, `dev:console`)
  actor     String
  /// what it relates to (`order:42`)
  ref       String?
  /// `[{ account, asset, delta }]`, per asset the deltas sum to zero
  legs      Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@id([planetId, tick, idx])
  @@schema("world")
  @@map("ledger_entry")
}
