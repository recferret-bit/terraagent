/// F1 Orbital Cargo outbox & status ledger (DATA_MODEL `chain.cargo_tx`, W10-08).
/// Written in the same transaction as the `chain_outbox` row (`cargo-export:{colonyId}:{seq}` / `cargo-import:{colonyId}:{seq}`).
model CargoTx {
  id          BigInt   @id @default(autoincrement())
  opId        String   @unique @map("op_id") @db.VarChar(160)
  planetId    String?  @map("planet_id") @db.VarChar(64)
  colonyId    String   @map("colony_id") @db.VarChar(64)
  colonyIndex Int?     @map("colony_index")
  accountId   String?  @map("account_id") @db.VarChar(64)
  direction   String   @db.VarChar(16)
  resource    String   @db.VarChar(32)
  amount      Decimal  @db.Decimal(40, 0)
  state       String   @default("PENDING") @db.VarChar(16)
  txHash      String?  @map("tx_hash") @db.VarChar(96)
  simRef      String   @map("sim_ref") @db.VarChar(160)
  lastError   String?  @map("last_error") @db.VarChar(400)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([colonyId, state])
  @@index([colonyId, direction, createdAt])
  @@map("cargo_tx")
  @@schema("chain")
}
