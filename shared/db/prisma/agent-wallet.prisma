/// Mock limited function-call key (W15-03, NEAR-80, NEAR-81). `gasAllowance` is not principal and is not spent by reserve or consume.
model MockChainAgentKey {
  accountId    String    @map("account_id") @db.VarChar(64)
  publicKey    String    @map("public_key") @db.VarChar(128)
  receiverId   String    @map("receiver_id") @db.VarChar(64)
  methodNames  Json      @map("method_names")
  gasAllowance Decimal   @map("gas_allowance") @db.Decimal(78, 0)
  gasSpent     Decimal   @default(0) @map("gas_spent") @db.Decimal(78, 0)
  revoked      Boolean   @default(false)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  allowances MockChainAgentAllowance[]

  @@id([accountId, publicKey])
  @@map("mock_chain_agent_key")
  @@schema("chain")
}

/// Per-token principal pool for one limited key. Available is `allowance - reserved - spent` and is not stored.
model MockChainAgentAllowance {
  accountId String  @map("account_id") @db.VarChar(64)
  publicKey String  @map("public_key") @db.VarChar(128)
  token     String  @db.VarChar(96)
  allowance Decimal @db.Decimal(78, 0)
  reserved  Decimal @default(0) @db.Decimal(78, 0)
  spent     Decimal @default(0) @db.Decimal(78, 0)

  key MockChainAgentKey @relation(fields: [accountId, publicKey], references: [accountId, publicKey], onDelete: Cascade)

  @@id([accountId, publicKey, token])
  @@map("mock_chain_agent_allowance")
  @@schema("chain")
}
