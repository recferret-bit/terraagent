model ColonyHistory {
  id           String   @id
  playerId     String   @map("player_id")
  colonyId     String   @map("colony_id")
  name         String   @db.VarChar(64)
  planetId     String   @map("planet_id")
  planetName   String   @map("planet_name") @db.VarChar(64)
  planetType   String   @map("planet_type") @db.VarChar(32)
  stageReached Int      @default(1) @map("stage_reached")
  outcome      String   @db.VarChar(32)
  foundedAt    DateTime @default(now()) @map("founded_at") @db.Timestamptz(3)
  endedAt      DateTime @default(now()) @map("ended_at") @db.Timestamptz(3)

  @@index([playerId])
  @@map("colony_history")
  @@schema("core")
}

/// Durable input journal. Producers retain eventId across retries.
model ProgressionReceipt {
  id        String   @id
  playerId  String   @map("player_id")
  payload   Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([playerId])
  @@map("progression_receipt")
  @@schema("core")
}

/// Transactional effect queue; each consumer has its own idempotency key and retry lease.
model ProgressionEffect {
  id          String    @id
  kind        String
  playerId    String    @map("player_id")
  payload     Json
  attempts    Int       @default(0)
  availableAt DateTime  @default(now()) @map("available_at") @db.Timestamptz(3)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(3)
  lastError   String?   @map("last_error")
  lease       String?

  @@index([kind, completedAt, availableAt])
  @@map("progression_effect")
  @@schema("core")
}

/// Inputs committed with their authoritative simulation checkpoint, replayed until applied.
model ProgressionInbox {
  id        String @id
  planetId  String @map("planet_id")
  tick      Int
  payload   Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  @@index([planetId, tick])
  @@map("progression_inbox")
  @@schema("core")
}

model ProgressionEpoch {
  planetId String @id @map("planet_id")
  epoch String
  @@map("progression_epoch")
  @@schema("core")
}

/// Durable in-app notification inbox; unique effect ID provides consumer idempotency.
model PlayerNotification {
  id String @id
  playerId String @map("player_id")
  payload Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  @@index([playerId, createdAt])
  @@map("player_notification")
  @@schema("core")
}

// --- world.prisma ---
enum SnapshotKind {
  PERIODIC
  SHUTDOWN
  SEAL
  END
  HOURLY

  @@schema("world")
}

model PlanetSnapshot {
  id         BigInt       @id @default(autoincrement())
  planetId   String       @map("planet_id")
  tick       BigInt
  simVersion Int          @map("sim_version")
  /// "msgpack+gz"
  codec      String       @db.VarChar(16)
  /// compressed size
  sizeBytes  Int          @map("size_bytes")
  /// uncompressed size
  rawBytes   Int          @map("raw_bytes")
  /// of compressed bytes; corruption means fall back to the previous snapshot
  crc32      Int
  kind       SnapshotKind
  /// wall clock at capture; restart fast-run uses now - savedAt (CONTINUITY CT-51)
  savedAt    DateTime     @map("saved_at") @db.Timestamptz(3)
  data       Bytes
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([planetId, tick])
  @@index([planetId, tick(sort: Desc)])
  @@schema("world")
  @@map("planet_snapshot")
}

/// Server-only double-entry journal of a planet's colony resources (D-34): one row per sim posting. Clients only get
/// balances (`col.stock`); this table is the full history. Identity = (planet, tick, index of the posting in that tick).
model LedgerEntry {
  planetId  String   @map("planet_id")
  tick      BigInt
  /// index of the posting within its tick (deterministic: the sim's posting order)
  idx       Int
  /// closed reason code from the sim's catalog (`construction.spend`, …)
  reason    String
  /// who caused it (`player:p_123`, `system:landing`, `dev:console`)
  actor     String
  /// what it relates to (`order:42`)
  ref       String?
  /// `[{ account, asset, delta }]`, per asset the deltas sum to zero
  legs      Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@id([planetId, tick, idx])
  @@schema("world")
  @@map("ledger_entry")
}
