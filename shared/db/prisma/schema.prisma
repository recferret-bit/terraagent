  @@unique([colonyId, eventId, channel])
  @@index([colonyId, createdAt(sort: Desc)])
  @@map("mock_notify")
  @@schema("core")
}

// --- progression.prisma ---
/// Per-player lifetime progression facts (`counter` += delta, `max` = GREATEST(old, new), W12-02).
model PlayerFact {
  playerId  String   @map("player_id")
  family    String   @db.VarChar(64)
  metric    String   @default("counter") @db.VarChar(16)
  value     Int      @default(0)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@id([playerId, family])
  @@index([playerId])
  @@map("player_fact")
  @@schema("core")
}

/// Append-only achievement tier unlocks (`(playerId, achievementId)` unique, W12-03).
model AchievementUnlock {
  id            String   @id
  playerId      String   @map("player_id")
  achievementId String   @map("achievement_id") @db.VarChar(64)
  family        String   @db.VarChar(64)
  tier          Int
