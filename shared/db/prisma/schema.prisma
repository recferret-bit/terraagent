  @@unique([playerId, idempotencyKey])
  @@index([playerId, state])
  @@index([state, priority, createdAt])
  @@map("match_ticket")
  @@schema("core")
}

/// Persistent party row (5-member cap enforced in persistence store, W11-02).
model Party {
  id                String        @id
  code              String        @unique
  leaderId          String        @map("leader_id")
  planetId          String?       @map("planet_id")
