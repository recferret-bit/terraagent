  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  deed Deed @relation(fields: [colonyId], references: [colonyId], onDelete: Cascade)

  @@unique([colonyId, version])
  @@index([tokenId, version])
  @@map("deed_history")
  @@schema("chain")
}

