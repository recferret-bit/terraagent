}

/// Idempotent XP awards (`(playerId, source, sourceId)` unique, W12-05).
model XpLedger {
  id        String   @id
  playerId  String   @map("player_id")
  source    String   @db.VarChar(32)
  sourceId  String   @map("source_id") @db.VarChar(128)
  delta     Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([playerId, source, sourceId])
  @@index([playerId])
  @@map("xp_ledger")
  @@schema("core")
}

/// Past colony records for `/v1/me/profile` and `/v1/me/history` (W12-09).
model ColonyHistory {
  id           String   @id
  playerId     String   @map("player_id")
  colonyId     String   @map("colony_id")
  name         String   @db.VarChar(64)
  planetId     String   @map("planet_id")
  planetName   String   @map("planet_name") @db.VarChar(64)
  planetType   String   @map("planet_type") @db.VarChar(32)
  stageReached Int      @default(1) @map("stage_reached")
  outcome      String   @db.VarChar(32)
  foundedAt    DateTime @default(now()) @map("founded_at") @db.Timestamptz(3)
  endedAt      DateTime @default(now()) @map("ended_at") @db.Timestamptz(3)

  @@index([playerId])
  @@map("colony_history")
  @@schema("core")
}

/// Durable input journal. Producers retain eventId across retries.
model ProgressionReceipt {
  id        String   @id
  playerId  String   @map("player_id")
  payload   Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([playerId])
  @@map("progression_receipt")
  @@schema("core")
}

/// Transactional effect queue; each consumer has its own idempotency key and retry lease.
model ProgressionEffect {
  id          String    @id
  kind        String
  playerId    String    @map("player_id")
  payload     Json
  attempts    Int       @default(0)
  availableAt DateTime  @default(now()) @map("available_at") @db.Timestamptz(3)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(3)
  lastError   String?   @map("last_error")
  lease       String?

  @@index([kind, completedAt, availableAt])
  @@map("progression_effect")
  @@schema("core")
}

/// Inputs committed with their authoritative simulation checkpoint, replayed until applied.
model ProgressionInbox {
  id        String @id
  planetId  String @map("planet_id")
  tick      Int
  payload   Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  @@index([planetId, tick])
  @@map("progression_inbox")
  @@schema("core")
}

model ProgressionEpoch {
  planetId String @id @map("planet_id")
  epoch String
  @@map("progression_epoch")
  @@schema("core")
}

/// Durable in-app notification inbox; unique effect ID provides consumer idempotency.
model PlayerNotification {
  id String @id
  playerId String @map("player_id")
  payload Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  @@index([playerId, createdAt])
  @@map("player_notification")
  @@schema("core")
}

// --- trade-api.prisma ---
/// API key of a bot / agent bound to one colony account (W13 trade API). Only the SHA-256 of the secret is stored; the
/// secret is shown once at creation. `scopes`: read | trade | manage.
model TradeApiKey {
  keyId         String    @id @map("key_id") @db.VarChar(40)
  secretHash    String    @unique @map("secret_hash") @db.VarChar(64)
  ownerId       String    @map("owner_id") @db.VarChar(64)
  label         String    @db.VarChar(64)
  planetId      String    @map("planet_id") @db.VarChar(64)
  colonyId      String    @map("colony_id") @db.VarChar(64)
  colonyIndex   Int       @map("colony_index")
  accountId     String    @map("account_id") @db.VarChar(64)
  scopes        String[]
  /// Per-key rate limit; null = module default.
  ratePerSecond Int?      @map("rate_per_second")
  rateBurst     Int?      @map("rate_burst")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt    DateTime? @map("last_used_at") @db.Timestamptz(3)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(3)

  @@index([ownerId])
  @@map("trade_api_key")
  @@schema("chain")
}

/// Safety rails of one key (W13 agent allowance). Amounts are quote atomic (USDC unless the pair's quote differs).
model TradeApiAllowance {
  keyId            String   @id @map("key_id") @db.VarChar(40)
  maxOpenOrders    Int      @map("max_open_orders")
  maxOrderNotional Decimal  @map("max_order_notional") @db.Decimal(78, 0)
  dailyBudget      Decimal  @map("daily_budget") @db.Decimal(78, 0)
  allowedPairs     String[] @map("allowed_pairs")
  /// Max distance of the order's unit price from the reference (organic VWAP) in bp; null = no band.
  priceBandBp      Int?     @map("price_band_bp")
  killSwitch       Boolean  @default(false) @map("kill_switch")
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("trade_api_allowance")
  @@schema("chain")
}

/// One mutating trade API request (place / cancel): the idempotency record AND the allowance ledger (outstanding orders
/// count from the moment the row exists, before any fill). `ownerRef` = `key:<keyId>` or `player:<playerId>`.
model TradeApiRequest {
  requestId     String   @id @map("request_id") @db.VarChar(40)
  ownerRef      String   @map("owner_ref") @db.VarChar(80)
  keyId         String?  @map("key_id") @db.VarChar(40)
  idemKey       String   @map("idem_key") @db.VarChar(80)
  bodyHash      String   @map("body_hash") @db.VarChar(64)
  kind          String   @db.VarChar(8)
  planetId      String   @map("planet_id") @db.VarChar(64)
  colonyId      String   @map("colony_id") @db.VarChar(64)
  colonyIndex   Int      @map("colony_index")
  ownerId       String   @map("owner_id") @db.VarChar(64)
  pair          String?  @db.VarChar(48)
  side          String?  @db.VarChar(4)
  resource      String?  @db.VarChar(32)
  amount        Decimal? @db.Decimal(78, 0)
  priceAmount   Decimal? @map("price_amount") @db.Decimal(78, 0)
  /// Quote atomic this request commits against the allowance (the order's total quote).
  notional      Decimal  @default(0) @db.Decimal(78, 0)
  /// PENDING (row written, sim not called) | SUBMITTED | ACCEPTED (order exists) | REJECTED | CANCELLED | FAILED
  state         String   @default("PENDING") @db.VarChar(12)
  commandId     String?  @map("command_id") @db.VarChar(40)
  orderId       String?  @map("order_id") @db.VarChar(64)
  targetOrderId String?  @map("target_order_id") @db.VarChar(64)
  errorCode     String?  @map("error_code") @db.VarChar(48)
  errorDetail   String?  @map("error_detail") @db.VarChar(400)
  /// Structured `error.details` of the rejection (allowance numbers, ...), replayed with the first answer.
  errorDetails  Json?    @map("error_details")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([ownerRef, idemKey])
  @@index([keyId, createdAt])
  @@index([colonyId, state])
  @@map("trade_api_request")
  @@schema("chain")
}

// --- world.prisma ---
enum SnapshotKind {
  PERIODIC
  SHUTDOWN
  SEAL
  END
  HOURLY

  @@schema("world")
}

model PlanetSnapshot {
  id         BigInt       @id @default(autoincrement())
  planetId   String       @map("planet_id")
  tick       BigInt
  simVersion Int          @map("sim_version")
  /// "msgpack+gz"
  codec      String       @db.VarChar(16)
  /// compressed size
  sizeBytes  Int          @map("size_bytes")
  /// uncompressed size
  rawBytes   Int          @map("raw_bytes")
  /// of compressed bytes; corruption means fall back to the previous snapshot
  crc32      Int
  kind       SnapshotKind
  /// wall clock at capture; restart fast-run uses now - savedAt (CONTINUITY CT-51)
  savedAt    DateTime     @map("saved_at") @db.Timestamptz(3)
  data       Bytes
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([planetId, tick])
  @@index([planetId, tick(sort: Desc)])
  @@schema("world")
  @@map("planet_snapshot")
}

/// Server-only double-entry journal of a planet's colony resources (D-34): one row per sim posting. Clients only get
/// balances (`col.stock`); this table is the full history. Identity = (planet, tick, index of the posting in that tick).
model LedgerEntry {
  planetId  String   @map("planet_id")
  tick      BigInt
  /// index of the posting within its tick (deterministic: the sim's posting order)
  idx       Int
  /// closed reason code from the sim's catalog (`construction.spend`, …)
  reason    String
  /// who caused it (`player:p_123`, `system:landing`, `dev:console`)
  actor     String
  /// what it relates to (`order:42`)
  ref       String?
  /// `[{ account, asset, delta }]`, per asset the deltas sum to zero
  legs      Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@id([planetId, tick, idx])
  @@schema("world")
  @@map("ledger_entry")
}
