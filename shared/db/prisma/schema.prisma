  unbondingReadyAt     DateTime? @map("unbonding_ready_at") @db.Timestamptz(3)
  withdrawableSnapshot Decimal   @default(0) @map("withdrawable_snapshot") @db.Decimal(40, 0)
  rewardsSnapshot      Decimal   @default(0) @map("rewards_snapshot") @db.Decimal(40, 0)
  updatedAt            DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@id([colonyId, poolId])
  @@index([accountId])
  @@map("staking_position")
  @@schema("chain")
}

