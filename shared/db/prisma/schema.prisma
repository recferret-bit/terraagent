  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  members PartyMember[]

  @@index([leaderId])
  @@map("party")
  @@schema("core")
}

/// Party membership row (`(partyId, playerId)` primary key, W11-02).
model PartyMember {
  partyId               String   @map("party_id")
  playerId              String   @map("player_id")
  handle                String
  joinedAt              DateTime @default(now()) @map("joined_at") @db.Timestamptz(3)
  colonyId              String?  @map("colony_id")
  reservedSectorId      String?  @map("reserved_sector_id")
  reservedLandingSlotId String?  @map("reserved_landing_slot_id")
