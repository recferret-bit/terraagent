// --- notify.prisma ---
/// Web Push or Telegram subscription (DATA_MODEL, CT-35). A set `revoked_at` means the row is dead.
model NotificationSubscription {
  id        String    @id @db.VarChar(80)
  playerId  String    @map("player_id") @db.VarChar(64)
  colonyId  String?   @map("colony_id") @db.VarChar(64)
  channel   String    @db.VarChar(16)
  endpoint  String?   @db.VarChar(500)
  p256dh    String?   @db.VarChar(200)
  authKey   String?   @map("auth_key") @db.VarChar(64)
  chatId    String?   @map("chat_id") @db.VarChar(64)
  /// Per-kind on/off. A missing key means that kind is on (CT-36).
  kinds     Json      @default("{}")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)

  @@index([playerId, channel])
  @@map("notification_subscription")
  @@schema("core")
}

/// One open or closed "while you were away" digest (CT-30..33). `body` is AwayDigestV1 JSON.
model PlanetEventDigest {
  id           BigInt    @id @default(autoincrement())
  colonyId     String    @map("colony_id") @db.VarChar(64)
  planetId     String    @map("planet_id") @db.VarChar(64)
  openedAt     DateTime  @map("opened_at") @db.Timestamptz(3)
  closedAt     DateTime? @map("closed_at") @db.Timestamptz(3)
  seenAt       DateTime? @map("seen_at") @db.Timestamptz(3)
  lastEventSeq BigInt    @default(0) @map("last_event_seq")
  body         Json
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([colonyId, openedAt(sort: Desc)])
  @@index([planetId, openedAt(sort: Desc)])
  @@map("planet_event_digest")
  @@schema("world")
}

/// Postgres mock notifier rows (W09-20, D-30). Idempotent per (colony, event, channel) (CT-38).
model MockNotify {
  id        BigInt   @id @default(autoincrement())
  colonyId  String   @map("colony_id") @db.VarChar(64)
  eventId   String   @map("event_id") @db.VarChar(128)
  channel   String   @db.VarChar(16)
  kind      String   @db.VarChar(40)
  payload   Json
