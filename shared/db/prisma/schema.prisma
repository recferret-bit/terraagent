  expiresAt     DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([planetId, sectorId, state])
  @@index([playerId, state])
  @@map("sector_reservation")
  @@schema("core")
}

/// Matchmaking admission ticket (`colonyId` unique, `(playerId, idempotencyKey)` unique, W11-02).
model MatchTicket {
  id                    String    @id
  playerId              String    @map("player_id")
  partyId               String?   @map("party_id")
  idempotencyKey        String?   @map("idempotency_key")
  mode                  String
  planetId              String    @map("planet_id")
  planetType            String    @map("planet_type")
  sectorIntentKind      String    @default("auto") @map("sector_intent_kind")
  requestedSectorId     String?   @map("requested_sector_id")
  state                 String    @default("QUEUED")
  priority              Int       @default(0)
  colonyId              String    @unique @map("colony_id")
  reservedPlanetId      String?   @map("reserved_planet_id")
  reservedSectorId      String?   @map("reserved_sector_id")
  reservedLandingSlotId String?   @map("reserved_landing_slot_id")
  reservationEpoch      Int?      @map("reservation_epoch")
  reservationExpiresAt  DateTime? @map("reservation_expires_at") @db.Timestamptz(3)
