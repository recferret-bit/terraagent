# Operator machine only. Copy the values you need into the repo-root .env (never commit that file).
# The server has its own /srv/terraagent/.env and does not need DEPLOY_HOST.
# An empty DEPLOY_HOST or DEPLOY_USER refuses deploy. SSH keys are copied by the owner, not by these scripts.

TA_DOMAIN=terraagent.fun
DEPLOY_HOST=
DEPLOY_USER=deploy
