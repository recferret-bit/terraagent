# Local PostHog admin & relay config (copy to infra/.env.posthog; NEVER commit infra/.env.posthog).
# `project_token` is the public write-only ingestion token (`phc_...`) used by the backend relay.
# `personal_api_key` (`phx_...`, or `project_api_key` if set to `phx_...`) is required ONLY for admin dashboard/insight sync and PostHog MCP verification.
project_token=
project_id=
region=eu
personal_api_key=
person_salt=
