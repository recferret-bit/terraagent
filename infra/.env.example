# Copy to .env for local overrides. Real environment variables win over .env.worktree, which wins over .env.
# Only the exact string `true` turns a boolean flag on (fail-closed).

# --- core (shared/config) ---
NODE_ENV=development
# Client UI target (`development` | `production`; unset follows Vite mode: `vite` -> local dev UI, `vite build` -> production UI
# with backtick console, #fx-bar shader switches, #fps-counter, BORDER: SOLID, and COMBAT LAB stripped).
# VITE_APP_ENV=development
# app = base+1, Vite client = base+1173, e2e app = base+2, e2e client = base+1174 (each worktree gets its own base)
TA_PORT_BASE=4000
# PORT=4001
TA_PG_PORT=15434
TA_DB_NAME=terraagent
# DATABASE_URL=postgresql://terra:terra@127.0.0.1:15434/terraagent
LOG_LEVEL=info
# CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# PLANET_DAY_HOURS=0.25
# PLANET_TIME_SCALE=1

# --- W06 / W23 NEAR adapters & Testnet -> Mainnet switch (unset = mock) ---
# Promote Testnet -> Mainnet:
#   1) NEAR_ALLOW_MAINNET=1 npm run near:deploy-contracts -- --network mainnet
#   2) Flip NEAR_MODE=mainnet, NEAR_ALLOW_MAINNET=1, NEAR_ROOT_ACCOUNT=terraagent.near
# NEAR_MODE=mock               # mock | testnet | devnet | mainnet (global default for all 11 NEAR ports; per-port NEAR_ADAPTER_<PORT> overrides)
# NEAR_ADAPTER_IDENTITY=testnet # enables live NEAR Testnet Sign-In/Sign-Up (FastAuth + NEP-413 wallets) across all pages while other chain ports stay mock
# NEAR_ALLOW_MAINNET=1         # required safety latch whenever NEAR_MODE=mainnet or any NEAR_ADAPTER_<PORT>=mainnet
# NEAR_ROOT_ACCOUNT=terraagent.testnet
# NEAR_PROTOCOL_ACCOUNT=protocol.terraagent.testnet
# NEAR_CONTRACT_RES=res.terraagent.testnet
# NEAR_CONTRACT_DEED=deed.terraagent.testnet
# NEAR_CONTRACT_BOUNTY=bounty.terraagent.testnet
# NEAR_CONTRACT_STAKING=staking.terraagent.testnet
# NEAR_CONTRACT_DAO=dao.terraagent.testnet
# NEAR_CONTRACT_PILOTS=pilots.terraagent.testnet
# NEAR_CONTRACT_VERIFIER=verifier.terraagent.testnet # W28: setting it turns on verifier settlement (key sync via register_account_key + strict on-chain balance preflight) in the testnet Intents adapter
# NEAR_VERIFIER_WASM=          # W28 deploy: wasm path override for verifier.<root> (default: backend/near-contracts target build of the verifier crate)
# NEAR_VERIFIER_WASM_SHA256=   # W28 deploy: optional hex sha256 pin; the deploy fails on mismatch
# NEAR_VERIFIER_STRICT_BALANCES=true # W28 deploy: init the verifier with strict_balances (false/0 deploys it off)
# NEAR_USE_PILOTS_FACTORY=true # create pilot sub-accounts via pilots.<root> with relayer/minter operator key (keeps root key cold)
# NEAR_RELAYER_DAILY_CAP=5     # hard pre-broadcast daily NEAR gas cap sponsored by relayer.<root> across NEP-366 meta-transactions
# NEAR_MIN_RELAYER_BALANCE=5   # /v1/near/status health-alert threshold on relayer.<root> (flags low_relayer_balance when below threshold)
# NEAR_RELAYER_MAX_DEPOSIT_NEAR=0.05 # hard pre-broadcast max attached deposit inside a sponsored NEP-366 SignedDelegate
# NEAR_RELAYER_WALLET_DAILY_TX_BASE=25 # W28 wallet-shared daily NEP-366 gasless relay base cap (scales 1x/2x/4x/8x/15x across staking tiers)
# NEAR_TOKEN_WNEAR=            # override quote token (default wrap.testnet on testnet, wrap.near on mainnet)
# NEAR_TOKEN_USDC=             # override USDC token (default native Circle USDC on mainnet)
# NEAR_PLATFORM_FEE_BP=100     # standard buyer platform trade fee in bp (0..1000; default 100 = 1.00%)
# NEAR_STAKER_PLATFORM_FEE_BP=50 # W20 ladder only (TA_WAVES=..27): >= NEAR_STAKER_MIN_NEAR staker buyer fee in bp (0..NEAR_PLATFORM_FEE_BP; default 50). With W28 on, fees come from the 4-tier table (shared/contracts/src/staking/tiers.ts: 65/50/35/25 bp)
# NEAR_DAO_FEE_SHARE_BP=2000   # Planet Council DAO share of platform fee in bp (0..10000; default 2000 = 20%, remaining 80% -> NEAR_PROTOCOL_ACCOUNT)
# NEAR_STAKER_MIN_NEAR=10      # W20 ladder only (TA_WAVES=..27): minimum staked NEAR for the staker tier; W28 tiers are 10/50/200/500 NEAR
# NEAR_PROTOCOL_STAKING_YIELD_BP=2000 # Protocol treasury share of accrued validator staking yield in bp (0..10000; default 2000 = 20%, staker keeps 80%)
# NEAR_ESCROW_SLASH_PROTOCOL_BP=1000 # Protocol treasury share of slashed Peace/War bonds in bp (0..10000; default 1000 = 10%, remaining 90% -> victim/defender)
# NEAR_ROOT_SECRET_KEY=        # optional cold root key (ed25519:...); omit in prod when using pilots.<root> factory
# NEAR_RELAYER_SECRET_KEY=     # ed25519:... for NEP-366 meta-tx sponsorship & pilots.<root> operator calls
# NEAR_MINTER_SECRET_KEY=      # ed25519:... for Cargo / Deed / Bounty / Staking / DAO operator calls (also the verifier operator for W28 key sync + execute_intents)
# NEAR_PROTOCOL_SECRET_KEY=    # optional ed25519:... for protocol.<root> on Mainnet intents.near signing (defaults to minter/relayer fallback)
# NEAR_DAO_SECRET_KEY=         # optional ed25519:... for dao.<root> on Mainnet intents.near signing (defaults to minter/relayer fallback)
# NEAR_KEK=                    # base64 of 32 bytes; unset uses the dev key, which production refuses
# MOCK_OAUTH_SECRET=terra-dev-mock-oauth-secret

# --- W12 / Hackathon AI Provider & Rival AI Seeding ---
# AI_PROVIDER=mock             # mock | nearai (NEAR AI Cloud TEE inference using z-ai/glm-5.3-flash)
# NEAR_AI_API_KEY=             # NEAR AI Cloud API key (https://cloud-api.near.ai/v1)
# NEAR_AI_MODEL=z-ai/glm-5.3-flash # NEAR AI Cloud default model for non-player AI bots
# NEAR_AI_SIGNING_ALGO=ecdsa   # ecdsa (EIP-191 secp256k1) | ed25519 (RFC 8032) for /v1/signature/{chat_id} TEE verification
# NEAR_AI_STRICT_CRYPTO_VERIFY=true # require full-length cryptographic signature verification on every TEE attestation
# NEAR_AI_TRUSTED_SIGNERS=     # optional comma-separated allowlist of trusted TEE enclave signing_address values
# AI_LIVE=1                    # enable live LLM calls outside NODE_ENV=production
# TA_SEED_RIVAL_AI=1           # auto-seed 2 established Stage-4 Rival AI Colonies per planet
# TA_ALLOW_PUBLIC_LIVE_SIM_LLM=false # keep false in prod so unauthenticated /dev/economy-sim runs never burn server LLM quota
# TA_DEV_AUTO_FUND_AI_TRADES=false   # keep false on testnet/mainnet; auto-mint AI verifier balances only in mock/local dev
# SHADE_AGENT_ALLOWED_MRTDS=         # comma-separated TDX MRTD hex allowlist required for Shade Agents in production
