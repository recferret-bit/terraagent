# Copy to .env for local overrides. Real environment variables win over .env.worktree, which wins over .env.
# Only the exact string `true` turns a boolean flag on (fail-closed).

# --- core (shared/config) ---
NODE_ENV=development
# app = base+1, Vite client = base+1173, e2e app = base+2, e2e client = base+1174 (each worktree gets its own base)
TA_PORT_BASE=4000
# PORT=4001
TA_PG_PORT=15434
TA_DB_NAME=terraagent
# DATABASE_URL=postgresql://terra:terra@127.0.0.1:15434/terraagent
LOG_LEVEL=info
# CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# PLANET_DAY_HOURS=0.25
# PLANET_TIME_SCALE=1

# --- W06 / W23 NEAR adapters & global switch (unset = mock) ---
# NEAR_MODE=mock               # mock | testnet | devnet | mainnet (global default for all 11 NEAR ports; per-port NEAR_ADAPTER_<PORT> overrides)
# NEAR_ROOT_ACCOUNT=terraagent.testnet
# NEAR_CONTRACT_STAKING=staking.terraagent.testnet
# NEAR_CONTRACT_DAO=dao.terraagent.testnet
# NEAR_ROOT_SECRET_KEY=        # ed25519:... for sub-account provisioning on testnet
# NEAR_RELAYER_SECRET_KEY=     # ed25519:... for NEP-366 meta-tx sponsorship on testnet
# NEAR_MINTER_SECRET_KEY=      # ed25519:... for Cargo / Deed / Bounty operator calls on testnet
# NEAR_KEK=                    # base64 of 32 bytes; unset uses the dev key, which production refuses
# MOCK_OAUTH_SECRET=terra-dev-mock-oauth-secret

# --- W12 / Hackathon AI Provider & Rival AI Seeding ---
# AI_PROVIDER=mock             # mock | nearai (NEAR AI Cloud TEE inference using z-ai/glm-5.3-flash)
# NEAR_AI_API_KEY=             # NEAR AI Cloud API key (https://cloud-api.near.ai/v1)
# NEAR_AI_MODEL=z-ai/glm-5.3-flash # NEAR AI Cloud default model for non-player AI bots
# AI_LIVE=1                    # enable live LLM calls outside NODE_ENV=production
# TA_SEED_RIVAL_AI=1           # auto-seed 2 established Stage-4 Rival AI Colonies per planet
