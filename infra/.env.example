# Copy to .env for local overrides. Real environment variables win over .env.worktree, which wins over .env.
# Only the exact string `true` turns a boolean flag on (fail-closed).

# --- core (shared/config) ---
NODE_ENV=development
# app = base+1, Vite client = base+1173, e2e app = base+2, e2e client = base+1174 (each worktree gets its own base)
TA_PORT_BASE=4000
# PORT=4001
TA_PG_PORT=15434
TA_DB_NAME=terraagent
# DATABASE_URL=postgresql://terra:terra@127.0.0.1:15434/terraagent
LOG_LEVEL=info
# CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# PLANET_DAY_HOURS=0.25
# PLANET_TIME_SCALE=1

# --- W06 / W23 NEAR adapters & Testnet -> Mainnet switch (unset = mock) ---
# Promote Testnet -> Mainnet:
#   1) NEAR_ALLOW_MAINNET=1 npm run near:deploy-contracts -- --network mainnet
#   2) Flip NEAR_MODE=mainnet, NEAR_ALLOW_MAINNET=1, NEAR_ROOT_ACCOUNT=terraagent.near
# NEAR_MODE=mock               # mock | testnet | devnet | mainnet (global default for all 11 NEAR ports; per-port NEAR_ADAPTER_<PORT> overrides)
# NEAR_ADAPTER_IDENTITY=testnet # enables live NEAR Testnet Sign-In/Sign-Up (FastAuth + NEP-413 wallets) across all pages while other chain ports stay mock
# NEAR_ALLOW_MAINNET=1         # required safety latch whenever NEAR_MODE=mainnet or any NEAR_ADAPTER_<PORT>=mainnet
# NEAR_ROOT_ACCOUNT=terraagent.testnet
# NEAR_PROTOCOL_ACCOUNT=protocol.terraagent.testnet
# NEAR_CONTRACT_RES=res.terraagent.testnet
# NEAR_CONTRACT_DEED=deed.terraagent.testnet
# NEAR_CONTRACT_BOUNTY=bounty.terraagent.testnet
# NEAR_CONTRACT_STAKING=staking.terraagent.testnet
# NEAR_CONTRACT_DAO=dao.terraagent.testnet
# NEAR_CONTRACT_PILOTS=pilots.terraagent.testnet
# NEAR_USE_PILOTS_FACTORY=true # create pilot sub-accounts via pilots.<root> with relayer/minter operator key (keeps root key cold)
# NEAR_RELAYER_MAX_DEPOSIT_NEAR=0.05 # max attached deposit allowed inside a sponsored NEP-366 SignedDelegate
# NEAR_TOKEN_WNEAR=            # override quote token (default wrap.testnet on testnet, wrap.near on mainnet)
# NEAR_TOKEN_USDC=             # override USDC token (default native Circle USDC on mainnet)
# NEAR_PLATFORM_FEE_BP=100     # standard buyer platform trade fee in bp (0..1000; default 100 = 1.00%)
# NEAR_STAKER_PLATFORM_FEE_BP=50 # Day-1 >= NEAR_STAKER_MIN_NEAR staker buyer platform fee in bp (0..NEAR_PLATFORM_FEE_BP; default 50 = 0.50%)
# NEAR_DAO_FEE_SHARE_BP=2000   # Planet Council DAO share of platform fee in bp (0..10000; default 2000 = 20%, remaining 80% -> NEAR_PROTOCOL_ACCOUNT)
# NEAR_STAKER_MIN_NEAR=10      # minimum staked NEAR unlocking Managed NEAR.AI Autopilot + staker trade fee tier
# NEAR_ESCROW_SLASH_PROTOCOL_BP=1000 # Protocol treasury share of slashed Peace/War bonds in bp (0..5000; default 1000 = 10%, remaining 90% -> victim/defender)
# NEAR_ROOT_SECRET_KEY=        # optional cold root key (ed25519:...); omit in prod when using pilots.<root> factory
# NEAR_RELAYER_SECRET_KEY=     # ed25519:... for NEP-366 meta-tx sponsorship & pilots.<root> operator calls
# NEAR_MINTER_SECRET_KEY=      # ed25519:... for Cargo / Deed / Bounty / Staking / DAO operator calls
# NEAR_PROTOCOL_SECRET_KEY=    # optional ed25519:... for protocol.<root> on Mainnet intents.near signing (defaults to minter/relayer fallback)
# NEAR_DAO_SECRET_KEY=         # optional ed25519:... for dao.<root> on Mainnet intents.near signing (defaults to minter/relayer fallback)
# NEAR_KEK=                    # base64 of 32 bytes; unset uses the dev key, which production refuses
# MOCK_OAUTH_SECRET=terra-dev-mock-oauth-secret

# --- W12 / Hackathon AI Provider & Rival AI Seeding ---
# AI_PROVIDER=mock             # mock | nearai (NEAR AI Cloud TEE inference using z-ai/glm-5.3-flash)
# NEAR_AI_API_KEY=             # NEAR AI Cloud API key (https://cloud-api.near.ai/v1)
# NEAR_AI_MODEL=z-ai/glm-5.3-flash # NEAR AI Cloud default model for non-player AI bots
# AI_LIVE=1                    # enable live LLM calls outside NODE_ENV=production
# TA_SEED_RIVAL_AI=1           # auto-seed 2 established Stage-4 Rival AI Colonies per planet
