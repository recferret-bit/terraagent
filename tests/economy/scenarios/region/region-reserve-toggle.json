{
  "schemaVersion": 1,
  "id": "region-reserve-toggle",
  "version": 1,
  "description": "Adversary: units toggled in and out of reserve every 60 ticks; the exhausted service floor must not recover by cycling.",
  "waves": "..13",
  "populations": [
    {
      "cohort": "specialist",
      "colonies": 1,
      "params": {}
    }
  ],
  "shocks": [
    {
      "kind": "reserveToggle",
      "atTick": 200,
      "params": {
        "everyTicks": 60
      }
    }
  ],
  "assumptions": {
    "region": {
      "planetType": "temperate",
      "extractors": 1,
      "units": 3,
      "depots": 0,
      "routeTiles": 4,
      "stock": {
        "bio.water": 2,
        "metals.t1": 60,
        "minerals.t1": 60
      }
    },
    "tradeResources": [
      "bio.water",
      "metals.t1",
      "minerals.t1",
      "minerals.t3"
    ],
    "gates": [
      {
        "gateId": "logistics.service_floor",
        "gateVersion": 1,
        "metricKey": "logistics.min_service_bp",
        "scope": "sector:0",
        "aggregate": "min",
        "op": "gte",
        "threshold": "5000"
      }
    ]
  }
}
