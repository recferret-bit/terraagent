{
  "schemaVersion": 1,
  "id": "stress-gate-probe",
  "version": 1,
  "description": "DELIBERATELY FAILING probe on a stress layout (an economic gate no run can meet): proves a failing stress seed reproduces from its replay command. Excluded from the pass expectation of the suite.",
  "waves": "..13",
  "populations": [
    {
      "cohort": "probe",
      "colonies": 2,
      "params": {}
    }
  ],
  "shocks": [],
  "assumptions": {
    "label": "ASSUMPTIONS, NOT OBSERVATIONS: every number here is a stress-suite assumption; demand source is 'assumed'.",
    "assumptionsVersion": 1,
    "demandSource": "assumed",
    "baseScenario": "stress",
    "tradeResources": [
      "bio.water",
      "bio.biomass",
      "metals.t1",
      "minerals.t1"
    ],
    "behavior": {
      "exportLot": 40,
      "buyLot": 30,
      "keepUnits": 150,
      "exportAbove": 320,
      "buyBelow": 280
    },
    "stress": {
      "colonies": 2,
      "extractors": 1,
      "radius": 80,
      "planetType": "temperate",
      "starterStock": {
        "bio.water": 300,
        "bio.biomass": 200,
        "metals.t1": 300,
        "minerals.t1": 300,
        "minerals.t2": 60
      },
      "stockByColony": {
        "0": {
          "bio.water": 700,
          "minerals.t2": 60
        },
        "1": {
          "bio.water": 100,
          "minerals.t2": 60
        }
      },
      "behavior": {
        "projectId": "project.survey_array",
        "projectEveryTicks": 300
      }
    },
    "gates": [
      {
        "gateId": "probe.impossible_trade_count",
        "gateVersion": 1,
        "metricKey": "market.trades",
        "scope": "global",
        "aggregate": "max",
        "op": "gte",
        "threshold": "1000000"
      }
    ]
  }
}
