      "extractors": 1,
      "radius": 80,
      "planetType": "temperate",
      "starterStock": {
        "bio.water": 300,
        "bio.biomass": 200,
        "metals.t1": 300,
        "minerals.t1": 300,
        "minerals.t2": 60
      },
      "stockByColony": {
        "0": {
          "bio.water": 700,
          "bio.biomass": 200,
          "metals.t1": 300,
          "minerals.t1": 500,
          "minerals.t2": 60
        },
        "1": {
          "bio.water": 100,
          "bio.biomass": 200,
          "metals.t1": 300,
          "minerals.t1": 100,
          "minerals.t2": 60
        }
      },
      "behavior": {
        "projectId": "project.survey_array",
        "projectEveryTicks": 300
      }
    },
    "gates": [
      {
        "gateId": "econ.position_nonnegative",
        "gateVersion": 1,
        "metricKey": "inventory.position",
        "scope": "global",
        "resource": "minerals.t1",
        "aggregate": "min",
        "op": "gte",
        "threshold": "0"
      }
    ]
  }
}
