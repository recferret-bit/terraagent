{
  "schemaVersion": 1,
  "id": "stress-thin-market",
  "version": 1,
  "description": "Thin market: only two colonies, one traded resource, large lots so few orders can match.",
  "waves": "..13",
  "populations": [
    {
      "cohort": "thin",
      "colonies": 2,
      "params": {}
    }
  ],
  "shocks": [],
  "assumptions": {
    "label": "ASSUMPTIONS, NOT OBSERVATIONS: every number here is a stress-suite assumption; demand source is 'assumed'.",
    "assumptionsVersion": 1,
    "demandSource": "assumed",
    "baseScenario": "stress",
    "tradeResources": [
      "minerals.t1"
    ],
    "behavior": {
      "exportLot": 120,
      "buyLot": 120,
      "keepUnits": 200,
      "exportAbove": 400,
      "buyBelow": 250
